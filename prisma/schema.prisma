generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                                       Int                                   @id @default(autoincrement())
  slug                                     String                                @unique @db.VarChar(64)
  name                                     String
  address                                  String?                               @db.VarChar(255)
  phone_prefix                             String                                @default("591") @db.VarChar(8)
  phone                                    String                                @db.VarChar(32)
  email                                    String?
  google_maps_url                          String?                               @db.VarChar(512)
  timezone                                 String                                @db.VarChar(64)
  currency                                 String                                @default("Bs.") @db.VarChar(3)
  logo_url                                 String?                               @db.VarChar(512)
  home_hero_image_url                      String?                               @db.VarChar(512)
  about_hero_image_url                     String?                               @db.VarChar(512)
  about_image_1_url                        String?                               @db.VarChar(512)
  about_image_2_url                        String?                               @db.VarChar(512)
  about_image_3_url                        String?                               @db.VarChar(512)
  is_active                                Boolean                               @default(true)
  created_at                               DateTime                              @default(now())
  updated_at                               DateTime                              @updatedAt
  deleted_at                               DateTime?
  company_type_id                          Int
  city                                     String?                               @db.VarChar(128)
  country_code                             String?                               @db.VarChar(2)
  state                                    String?                               @db.VarChar(128)
  latitude                                 Float?
  longitude                                Float?
  about_us_hero_text                       String?                               @db.Text
  about_us_text                            String?                               @db.Text
  our_story_text                           String?                               @db.Text
  plan                                     ShopPlan                              @default(BUSINESS)
  billingCycle                             BillingCycle                          @default(MONTHLY) @map("billing_cycle")
  pricePaid                                Decimal?                              @map("price_paid") @db.Decimal(10, 2)
  availableUntil                           DateTime                              @default(dbgenerated("'2027-03-12 23:59:59.000'")) @map("available_until")
  isMarketplaceVisible                     Boolean                               @default(true) @map("is_marketplace_visible")
  bookings                                 Booking[]
  booking_audit_logs                       BookingAuditLog[]
  booking_notification_attempts            BookingNotificationAttempt[]
  outbound_message_batches                 OutboundMessageBatch[]
  outbound_message_jobs                    OutboundMessageJob[]
  booking_discounts                        BookingDiscount[]
  booking_services                         BookingService[]
  categories                               Category[]
  company_type                             CompanyType                           @relation(fields: [company_type_id], references: [id])
  capability_overrides                     CompanyCapabilityOverride[]
  company_settings                         CompanySettings?
  company_users                            CompanyUser[]
  product_history                          CompanyProductHistory[]
  product_access_requests                  ProductAccessRequest[]
  product_subscriptions                    CompanyProductSubscription[]
  config_messages                          ConfigMessage[]
  customer_profiles                        CustomerProfile[]
  discount_codes                           DiscountCode[]
  hours                                    Hours[]
  reviews                                  Review[]
  services                                 Service[]
  staff_profiles                           StaffProfile[]
  subscription_history                     CompanySubscriptionHistory[]
  staff_availability                       StaffAvailability[]
  staff_time_off                           StaffTimeOff[]
  staff_services                           StaffService[]
  theme_config                             ThemeConfig?
  group_events                             GroupEvent[]
  group_classes                            GroupClass[]
  group_class_sessions                     GroupClassSession[]
  group_staff_assignments                  GroupStaffAssignment[]
  group_event_bookings                     GroupEventBooking[]
  group_class_enrollments                  GroupClassEnrollment[]
  group_session_attendances                GroupSessionAttendance[]
  group_tickets                            GroupTicket[]
  group_event_interests                    GroupEventInterest[]
  group_class_interests                    GroupClassInterest[]
  free_event_registrations                 FreeEventRegistration[]
  paid_event_guest_checkout_sessions       PaidEventGuestCheckoutSession[]
  group_class_guest_enrollment_sessions    GroupClassGuestEnrollmentSession[]
  group_session_public_attendance_attempts GroupSessionPublicAttendanceAttempt[]
  service_required_resources               ServiceRequiredResource[]
  installment_reminder_logs                InstallmentReminderLog[]
  booking_groups                           BookingGroup[]
  commerce_store                           CommerceStore?
  commerce_order_sequence                  CommerceOrderSequence?
  commerce_categories                      CommerceCategory[]
  commerce_products                        CommerceProduct[]
  commerce_pickup_points                   CommercePickupPoint[]
  commerce_points_of_sale                  CommercePointOfSale[]
  commerce_order_schedule_slots            CommerceOrderScheduleSlot[]
  commerce_orders                          CommerceOrder[]
  commerce_guest_checkout_sessions         CommerceGuestCheckoutSession[]
  restaurant_enabled                       Boolean                               @default(false)
  restaurant_settings                      RestaurantSettings?
  restaurant_dining_areas                  RestaurantDiningArea[]
  restaurant_tables                        RestaurantTable[]
  restaurant_service_periods               RestaurantServicePeriod[]
  restaurant_reservations                  RestaurantReservation[]
  restaurant_notification_logs             RestaurantNotificationLog[]
  restaurant_menu_categories               RestaurantMenuCategory[]
  restaurant_menu_items                    RestaurantMenuItem[]
  restaurant_shifts                        RestaurantShift[]
  restaurant_shift_members                 RestaurantShiftMember[]
  restaurant_shift_dining_areas            RestaurantShiftDiningArea[]
  restaurant_shift_table_assignments       RestaurantShiftTableAssignment[]
  restaurant_shift_templates               RestaurantShiftTemplate[]
  restaurant_table_states                  RestaurantTableOperationalState[]
  restaurant_table_combinations            RestaurantTableCombination[]
  restaurant_table_combination_tables      RestaurantTableCombinationTable[]
  restaurant_table_combination_sessions    RestaurantTableCombinationSession[]
  restaurant_reservation_assignments       RestaurantReservationAssignment[]
  restaurant_audit_logs                    RestaurantAuditLog[]
  restaurant_internal_notes                RestaurantInternalNote[]
  restaurant_visits                        RestaurantVisit[]
  restaurant_waitlist_entries              RestaurantWaitlist[]
  restaurant_waitlist_events               RestaurantWaitlistEvent[]
  restaurant_reservation_deposits          RestaurantReservationDeposit[]
  restaurant_customer_profiles             RestaurantCustomerProfile[]
  restaurant_shift_closeouts               RestaurantShiftCloseout[]
  restaurant_shift_closeout_adjustments    RestaurantShiftCloseoutAdjustment[]
  upload_intents                           UploadIntent[]

  @@index([availableUntil], map: "company_available_until_idx")
  @@index([plan, billingCycle], map: "company_plan_billing_cycle_idx")
  @@index([isMarketplaceVisible, is_active, city], map: "company_marketplace_visible_active_city_idx")
  @@index([city, country_code, is_active])
  @@index([is_active, city, state], map: "company_active_city_state_idx")
  @@index([company_type_id], map: "company_company_type_id_fkey")
  @@map("company")
}

model RestaurantSettings {
  id                             Int                   @id @default(autoincrement())
  company_id                     Int                   @unique
  average_dining_minutes         Int                   @default(90)
  slot_interval_minutes          Int                   @default(30)
  minimum_advance_minutes        Int                   @default(60)
  maximum_advance_days           Int                   @default(30)
  auto_confirm_reservations      Boolean               @default(true)
  allow_customer_cancellation    Boolean               @default(true)
  cancellation_limit_minutes     Int                   @default(120)
  minimum_party_size             Int                   @default(1)
  maximum_party_size             Int                   @default(12)
  require_phone                  Boolean               @default(true)
  require_email                  Boolean               @default(false)
  allow_walk_ins                 Boolean               @default(true)
  deposit_enabled                Boolean               @default(false)
  deposit_amount_cents           Int                   @default(0)
  deposit_mode                   RestaurantDepositMode @default(PER_TABLE)
  deposit_qr_image_url           String?               @db.VarChar(512)
  turnover_buffer_minutes        Int                   @default(15)
  cleanup_buffer_minutes         Int                   @default(10)
  at_risk_warning_window_minutes Int                   @default(30)
  created_at                     DateTime              @default(now())
  updated_at                     DateTime              @updatedAt
  company                        Company               @relation(fields: [company_id], references: [id])

  @@map("restaurant_settings")
}

model RestaurantDiningArea {
  id                                 Int                                 @id @default(autoincrement())
  company_id                         Int
  name                               String                              @db.VarChar(120)
  description                        String?                             @db.VarChar(500)
  sort_order                         Int                                 @default(0)
  is_active                          Boolean                             @default(true)
  created_at                         DateTime                            @default(now())
  updated_at                         DateTime                            @updatedAt
  company                            Company                             @relation(fields: [company_id], references: [id])
  tables                             RestaurantTable[]
  reservations_as_preferred_area     RestaurantReservation[]             @relation("RestaurantReservationPreferredArea")
  shift_dining_areas                 RestaurantShiftDiningArea[]
  combinations                       RestaurantTableCombination[]        @relation("RestaurantCombinationArea")
  restaurantShiftTemplateDiningAreas RestaurantShiftTemplateDiningArea[]
  waitlist_preferred_entries         RestaurantWaitlist[]                @relation("RestaurantWaitlistPreferredArea")
  restaurant_customer_profiles       RestaurantCustomerProfile[]         @relation("RestaurantCustomerPreferredArea")

  @@unique([company_id, name], map: "restaurant_dining_area_company_name_key")
  @@index([company_id], map: "restaurant_dining_area_company_id_idx")
  @@map("restaurant_dining_area")
}

model RestaurantTable {
  id                          Int                                      @id @default(autoincrement())
  company_id                  Int
  dining_area_id              Int
  name                        String                                   @db.VarChar(120)
  minimum_seats               Int                                      @default(1)
  maximum_seats               Int
  sort_order                  Int                                      @default(0)
  is_active                   Boolean                                  @default(true)
  created_at                  DateTime                                 @default(now())
  updated_at                  DateTime                                 @updatedAt
  company                     Company                                  @relation(fields: [company_id], references: [id])
  dining_area                 RestaurantDiningArea                     @relation(fields: [dining_area_id], references: [id])
  reservations                RestaurantReservation[]
  table_state                 RestaurantTableOperationalState?
  shift_assignments           RestaurantShiftTableAssignment[]
  combination_members         RestaurantTableCombinationTable[]
  reservation_assignments     RestaurantReservationAssignment[]
  template_assignments        RestaurantShiftTemplateTableAssignment[]
  audit_logs                  RestaurantAuditLog[]
  internal_notes              RestaurantInternalNote[]
  visits                      RestaurantVisit[]
  waitlist_entries            RestaurantWaitlist[]                     @relation("RestaurantWaitlistAssignedTable")
  preferred_customer_profiles RestaurantCustomerProfile[]

  @@unique([dining_area_id, name], map: "restaurant_table_area_name_key")
  @@index([company_id], map: "restaurant_table_company_id_idx")
  @@index([dining_area_id], map: "restaurant_table_dining_area_id_idx")
  @@map("restaurant_table")
}

model RestaurantServicePeriod {
  id          Int               @id @default(autoincrement())
  company_id  Int
  day_of_week Int
  name        String?           @db.VarChar(120)
  start_time  String            @db.VarChar(5)
  end_time    String            @db.VarChar(5)
  sort_order  Int               @default(0)
  is_active   Boolean           @default(true)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  company     Company           @relation(fields: [company_id], references: [id])
  shifts      RestaurantShift[]

  @@index([company_id, day_of_week], map: "restaurant_service_period_company_day_idx")
  @@map("restaurant_service_period")
}

model RestaurantReservation {
  id                               Int                                 @id @default(autoincrement())
  company_id                       Int
  customer_profile_id              Int?
  table_id                         Int?
  preferred_dining_area_id         Int?
  combination_id                   Int?
  reservation_code                 String                              @unique @db.VarChar(48)
  reservation_date                 DateTime
  start_time                       DateTime
  end_time                         DateTime
  party_size                       Int
  customer_name                    String                              @db.VarChar(160)
  customer_phone                   String?                             @db.VarChar(32)
  customer_email                   String?                             @db.VarChar(255)
  deposit_amount_cents             Int                                 @default(0)
  deposit_mode                     RestaurantDepositMode?
  deposit_proof_image_url          String?                             @db.VarChar(512)
  notes                            String?                             @db.Text
  internal_notes                   String?                             @db.Text
  status                           RestaurantReservationStatus         @default(PENDING)
  source                           RestaurantReservationSource         @default(ADMIN)
  seated_at                        DateTime?
  completed_at                     DateTime?
  cancelled_at                     DateTime?
  cancellation_reason              String?                             @db.VarChar(500)
  created_by_user_id               String?
  created_at                       DateTime                            @default(now())
  updated_at                       DateTime                            @updatedAt
  company                          Company                             @relation(fields: [company_id], references: [id])
  customer_profile                 CustomerProfile?                    @relation(fields: [customer_profile_id], references: [id])
  table                            RestaurantTable?                    @relation(fields: [table_id], references: [id])
  preferred_dining_area            RestaurantDiningArea?               @relation("RestaurantReservationPreferredArea", fields: [preferred_dining_area_id], references: [id])
  combination                      RestaurantTableCombination?         @relation(fields: [combination_id], references: [id])
  created_by_user                  User?                               @relation("RestaurantReservationCreatedBy", fields: [created_by_user_id], references: [id])
  guests                           RestaurantReservationGuest[]
  notification_logs                RestaurantNotificationLog[]
  assignments                      RestaurantReservationAssignment[]
  audit_logs                       RestaurantAuditLog[]
  restaurant_internal_note_records RestaurantInternalNote[]
  combination_sessions             RestaurantTableCombinationSession[]
  visit                            RestaurantVisit?
  deposit                          RestaurantReservationDeposit?
  waitlist_entry                   RestaurantWaitlist?

  @@index([company_id, reservation_date], map: "restaurant_reservation_company_date_idx")
  @@index([company_id, status], map: "restaurant_reservation_company_status_idx")
  @@index([company_id, source], map: "restaurant_reservation_company_source_idx")
  @@index([company_id, start_time], map: "restaurant_reservation_company_start_time_idx")
  @@index([company_id, status, start_time], map: "restaurant_reservation_company_status_start_time_idx")
  @@index([company_id, source, start_time], map: "restaurant_reservation_company_source_start_time_idx")
  @@index([table_id, start_time, end_time], map: "restaurant_reservation_table_time_idx")
  @@index([combination_id, start_time, end_time], map: "restaurant_reservation_combination_time_idx")
  @@index([company_id, preferred_dining_area_id, start_time], map: "restaurant_reservation_preferred_area_idx")
  @@map("restaurant_reservation")
}

model RestaurantReservationGuest {
  id             Int                   @id @default(autoincrement())
  reservation_id Int
  name           String                @db.VarChar(160)
  whatsapp_phone String                @db.VarChar(32)
  invited_at     DateTime?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt
  reservation    RestaurantReservation @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
  notification_logs RestaurantNotificationLog[] @relation("RestaurantGuestNotificationLogs")

  @@unique([reservation_id, whatsapp_phone], map: "restaurant_reservation_guest_phone_key")
  @@index([reservation_id], map: "restaurant_reservation_guest_reservation_id_idx")
  @@map("restaurant_reservation_guest")
}

model RestaurantVisit {
  id                      Int                                @id @default(autoincrement())
  company_id              Int
  reservation_id          Int?                               @unique
  shift_id                Int?
  table_id                Int?
  combination_session_id  Int?
  primary_waiter_user_id  String?
  primary_waiter_name     String?                            @db.VarChar(160)
  dining_area_snapshot    String?                            @db.VarChar(120)
  table_name_snapshot     String?                            @db.VarChar(120)
  shift_name_snapshot     String?                            @db.VarChar(160)
  guest_count             Int
  subtotal_amount_cents   Int                                @default(0)
  discount_amount_cents   Int                                @default(0)
  tip_amount_cents        Int                                @default(0)
  total_paid_amount_cents Int                                @default(0)
  currency                String                             @db.VarChar(3)
  payment_method          RestaurantVisitPaymentMethod       @default(OTHER)
  mixed_payment_breakdown Json?
  pos_reference           String?                            @db.VarChar(160)
  closing_notes           String?                            @db.Text
  status                  RestaurantVisitStatus              @default(DRAFT)
  closed_by_user_id       String?
  closed_at               DateTime?
  reopened_by_user_id     String?
  reopened_at             DateTime?
  created_at              DateTime                           @default(now())
  updated_at              DateTime                           @updatedAt
  company                 Company                            @relation(fields: [company_id], references: [id])
  reservation             RestaurantReservation?             @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  shift                   RestaurantShift?                   @relation(fields: [shift_id], references: [id], onDelete: SetNull)
  table                   RestaurantTable?                   @relation(fields: [table_id], references: [id], onDelete: SetNull)
  combination_session     RestaurantTableCombinationSession? @relation(fields: [combination_session_id], references: [id], onDelete: SetNull)
  primary_waiter          User?                              @relation("RestaurantVisitPrimaryWaiter", fields: [primary_waiter_user_id], references: [id], onDelete: SetNull)
  closed_by               User?                              @relation("RestaurantVisitClosedBy", fields: [closed_by_user_id], references: [id], onDelete: SetNull)
  reopened_by             User?                              @relation("RestaurantVisitReopenedBy", fields: [reopened_by_user_id], references: [id], onDelete: SetNull)
  waitlist_entry          RestaurantWaitlist?

  @@index([company_id, closed_at], map: "restaurant_visit_company_closed_at_idx")
  @@index([company_id, shift_id, closed_at], map: "restaurant_visit_company_shift_closed_idx")
  @@index([company_id, primary_waiter_user_id, closed_at], map: "restaurant_visit_company_waiter_closed_idx")
  @@index([company_id, table_id, closed_at], map: "restaurant_visit_company_table_closed_idx")
  @@index([company_id, payment_method, closed_at], map: "restaurant_visit_company_payment_closed_idx")
  @@map("restaurant_visit")
}

model RestaurantWaitlist {
  id                       Int                         @id @default(autoincrement())
  company_id               Int
  guest_name               String                      @db.VarChar(160)
  phone                    String?                     @db.VarChar(32)
  email                    String?                     @db.VarChar(255)
  customer_profile_id      Int?
  party_size               Int
  preferred_dining_area_id Int?
  accessibility_notes      String?                     @db.VarChar(1000)
  seating_notes            String?                     @db.VarChar(1000)
  arrival_time             DateTime                    @default(now())
  estimated_wait_minutes   Int                         @default(30)
  quoted_ready_at          DateTime?
  actual_ready_at          DateTime?
  notified_at              DateTime?
  seated_at                DateTime?
  left_at                  DateTime?
  cancelled_at             DateTime?
  linked_reservation_id    Int?                        @unique
  linked_visit_id          Int?                        @unique
  assigned_table_id        Int?
  assigned_combination_id  Int?
  source                   RestaurantWaitlistSource    @default(WALK_IN)
  status                   RestaurantWaitlistStatus    @default(WAITING)
  priority                 Int                         @default(0)
  manual_order             Int                         @default(0)
  internal_notes           String?                     @db.Text
  created_by_user_id       String?
  updated_by_user_id       String?
  created_at               DateTime                    @default(now())
  updated_at               DateTime                    @updatedAt
  company                  Company                     @relation(fields: [company_id], references: [id])
  customer_profile         CustomerProfile?            @relation(fields: [customer_profile_id], references: [id], onDelete: SetNull)
  preferred_dining_area    RestaurantDiningArea?       @relation("RestaurantWaitlistPreferredArea", fields: [preferred_dining_area_id], references: [id], onDelete: SetNull)
  linked_reservation       RestaurantReservation?      @relation(fields: [linked_reservation_id], references: [id], onDelete: SetNull)
  linked_visit             RestaurantVisit?            @relation(fields: [linked_visit_id], references: [id], onDelete: SetNull)
  assigned_table           RestaurantTable?            @relation("RestaurantWaitlistAssignedTable", fields: [assigned_table_id], references: [id], onDelete: SetNull)
  assigned_combination     RestaurantTableCombination? @relation(fields: [assigned_combination_id], references: [id], onDelete: SetNull)
  created_by               User?                       @relation("RestaurantWaitlistCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  updated_by               User?                       @relation("RestaurantWaitlistUpdatedBy", fields: [updated_by_user_id], references: [id], onDelete: SetNull)
  events                   RestaurantWaitlistEvent[]
  notification_logs        RestaurantNotificationLog[]

  @@index([company_id, status, manual_order, arrival_time], map: "restaurant_waitlist_company_queue_idx")
  @@index([company_id, preferred_dining_area_id, status], map: "restaurant_waitlist_company_area_status_idx")
  @@index([company_id, created_at], map: "restaurant_waitlist_company_created_idx")
  @@map("restaurant_waitlist")
}

model RestaurantWaitlistEvent {
  id            Int                       @id @default(autoincrement())
  company_id    Int
  waitlist_id   Int
  event         String                    @db.VarChar(80)
  from_status   RestaurantWaitlistStatus?
  to_status     RestaurantWaitlistStatus?
  actor_user_id String?
  metadata      Json?
  created_at    DateTime                  @default(now())
  company       Company                   @relation(fields: [company_id], references: [id])
  waitlist      RestaurantWaitlist        @relation(fields: [waitlist_id], references: [id], onDelete: Cascade)
  actor         User?                     @relation("RestaurantWaitlistEventActor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([company_id, waitlist_id, created_at], map: "restaurant_waitlist_event_history_idx")
  @@index([company_id, created_at], map: "restaurant_waitlist_event_company_created_idx")
  @@map("restaurant_waitlist_event")
}

model RestaurantReservationDeposit {
  id                    Int                             @id @default(autoincrement())
  company_id            Int
  reservation_id        Int                             @unique
  required_amount_cents Int
  currency              String                          @db.VarChar(3)
  mode                  RestaurantDepositMode
  status                RestaurantDepositStatus         @default(REQUIRED)
  payment_method        RestaurantDepositPaymentMethod?
  payment_deadline      DateTime?
  proof_path            String?                         @db.VarChar(512)
  proof_original_name   String?                         @db.VarChar(255)
  proof_mime_type       String?                         @db.VarChar(100)
  proof_size_bytes      Int?
  proof_sha256          String?                         @db.VarChar(128)
  proof_submitted_at    DateTime?
  submitted_by_user_id  String?
  public_submission_id  String?                         @db.VarChar(128)
  reviewed_by_user_id   String?
  reviewed_at           DateTime?
  rejection_reason      String?                         @db.VarChar(500)
  approved_at           DateTime?
  refunded_amount_cents Int                             @default(0)
  refunded_by_user_id   String?
  refunded_at           DateTime?
  refund_reason         String?                         @db.VarChar(500)
  created_at            DateTime                        @default(now())
  updated_at            DateTime                        @updatedAt
  company               Company                         @relation(fields: [company_id], references: [id])
  reservation           RestaurantReservation           @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
  submitted_by          User?                           @relation("RestaurantDepositSubmittedBy", fields: [submitted_by_user_id], references: [id], onDelete: SetNull)
  reviewed_by           User?                           @relation("RestaurantDepositReviewedBy", fields: [reviewed_by_user_id], references: [id], onDelete: SetNull)
  refunded_by           User?                           @relation("RestaurantDepositRefundedBy", fields: [refunded_by_user_id], references: [id], onDelete: SetNull)

  @@index([company_id, status, payment_deadline], map: "restaurant_deposit_company_status_deadline_idx")
  @@index([company_id, reservation_id], map: "restaurant_deposit_company_reservation_idx")
  @@map("restaurant_reservation_deposit")
}

model RestaurantCustomerProfile {
  id                         Int                   @id @default(autoincrement())
  company_id                 Int
  customer_profile_id        Int                   @unique
  vip                        Boolean               @default(false)
  vip_level                  String?               @db.VarChar(40)
  birthday                   DateTime?             @db.Date
  anniversary                DateTime?             @db.Date
  preferred_dining_area_id   Int?
  preferred_table_id         Int?
  preferred_waiter_user_id   String?
  seating_preference         String?               @db.VarChar(500)
  accessibility_requirements String?               @db.VarChar(1000)
  dietary_preferences        String?               @db.VarChar(1000)
  allergies                  String?               @db.VarChar(1000)
  favorite_items             Json?
  customer_facing_notes      String?               @db.VarChar(1000)
  internal_hospitality_notes String?               @db.Text
  tags                       Json?
  last_visit_at              DateTime?
  visit_count                Int                   @default(0)
  no_show_count              Int                   @default(0)
  cancellation_count         Int                   @default(0)
  total_spend_cents          Int                   @default(0)
  average_spend_cents        Int                   @default(0)
  average_party_size         Decimal               @default(0) @db.Decimal(8, 2)
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt
  company                    Company               @relation(fields: [company_id], references: [id])
  customer_profile           CustomerProfile       @relation(fields: [customer_profile_id], references: [id], onDelete: Cascade)
  preferred_dining_area      RestaurantDiningArea? @relation("RestaurantCustomerPreferredArea", fields: [preferred_dining_area_id], references: [id], onDelete: SetNull)
  preferred_table            RestaurantTable?      @relation(fields: [preferred_table_id], references: [id], onDelete: SetNull)
