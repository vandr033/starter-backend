// ─── Class Enrollment (pass/subscription for a class) ───────────────────────

model GroupClassEnrollment {
  id                                  Int                   @id @default(autoincrement())
  company_id                          Int
  group_class_id                      Int
  customer_profile_id                 Int?
  user_id                             String
  pricing_mode                        ClassPricingMode
  price_cents_snapshot                Int
  status                              GroupBookingStatus    @default(PENDING)
  payment_method                      PaymentMethod         @default(NONE)
  payment_status                      PaymentStatus         @default(UNPAID)
  qr_proof_image_url                  String?               @db.VarChar(512)
  source                              ClassEnrollmentSource @default(PUBLIC_CHECKOUT)
  is_admin_sponsored                  Boolean               @default(false)
  sponsorship_reason                  String?               @db.VarChar(255)
  sponsored_by_group_class_session_id Int?
  sponsored_by_admin_user_id          String?
  valid_from                          DateTime
  valid_until                         DateTime
  created_at                          DateTime              @default(now())
  updated_at                          DateTime              @updatedAt
  cancelled_at                        DateTime?

  company                          Company                  @relation(fields: [company_id], references: [id])
  group_class                      GroupClass               @relation(fields: [group_class_id], references: [id])
  customer_profile                 CustomerProfile?         @relation(fields: [customer_profile_id], references: [id])
  user                             User                     @relation(fields: [user_id], references: [id])
  attendances                      GroupSessionAttendance[]
  tickets                          GroupTicket[]
  installments                     EnrollmentInstallment[]
  installment_reminder_logs        InstallmentReminderLog[]
  sponsored_by_group_class_session GroupClassSession?       @relation("SponsoredBySession", fields: [sponsored_by_group_class_session_id], references: [id], onDelete: SetNull)
  sponsored_by_admin               User?                    @relation("ClassEnrollmentSponsoredByAdmin", fields: [sponsored_by_admin_user_id], references: [id], onDelete: SetNull)

  @@index([company_id, group_class_id, status])
  @@index([company_id, group_class_id, user_id, status, valid_until], map: "gce_cmp_cls_usr_sts_vu_idx")
  @@index([company_id, group_class_id, status, valid_from, valid_until], map: "gce_cmp_cls_sts_vf_vu_idx")
  @@index([user_id, group_class_id])
  @@index([customer_profile_id])
  @@index([is_admin_sponsored, status], map: "gce_sponsored_status_idx")
  @@index([source], map: "gce_source_idx")
  @@index([sponsored_by_group_class_session_id], map: "gce_sponsored_session_idx")
  @@index([sponsored_by_admin_user_id], map: "gce_sponsored_admin_idx")
  @@map("group_class_enrollment")
}

// ─── Enrollment Installment (monthly payment for FULL_COURSE) ───────────────

model EnrollmentInstallment {
  id                      Int           @id @default(autoincrement())
  enrollment_id           Int
  installment_number      Int
  due_date                DateTime      @db.Date
  amount_cents            Int
  payment_status          PaymentStatus @default(UNPAID)
  payment_method          PaymentMethod @default(NONE)
  qr_proof_image_url      String?       @db.VarChar(512)
  paid_at                 DateTime?
  marked_paid_by_admin_id String?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt

  enrollment           GroupClassEnrollment     @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  marked_paid_by_admin User?                    @relation("InstallmentMarkedPaidBy", fields: [marked_paid_by_admin_id], references: [id], onDelete: SetNull)
  reminder_logs        InstallmentReminderLog[]

  @@unique([enrollment_id, installment_number])
  @@index([enrollment_id])
  @@index([payment_status, due_date])
  @@index([marked_paid_by_admin_id])
  @@map("enrollment_installment")
}

model InstallmentReminderLog {
  id               Int      @id @default(autoincrement())
  company_id       Int
  enrollment_id    Int
  installment_id   Int
  sent_by_admin_id String?
  channel          String   @db.VarChar(16)
  recipient_email  String?  @db.VarChar(191)
  recipient_phone  String?  @db.VarChar(32)
  message_subject  String?  @db.VarChar(255)
  message_body     String?  @db.Text
  status           String   @default("SENT") @db.VarChar(32)
  sent_at          DateTime?
  outbound_message_job_id Int?

  company       Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  enrollment    GroupClassEnrollment  @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  installment   EnrollmentInstallment @relation(fields: [installment_id], references: [id], onDelete: Cascade)
  sent_by_admin User?                 @relation("InstallmentReminderSentBy", fields: [sent_by_admin_id], references: [id], onDelete: SetNull)
  outbound_message_job OutboundMessageJob? @relation("InstallmentReminderOutboxJob", fields: [outbound_message_job_id], references: [id], onDelete: SetNull)

  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([company_id, created_at], map: "installment_reminder_log_company_created_idx")
  @@index([enrollment_id, created_at], map: "installment_reminder_log_enrollment_created_idx")
  @@index([installment_id, created_at], map: "installment_reminder_log_installment_created_idx")
  @@index([sent_by_admin_id])
  @@index([channel, created_at], map: "installment_reminder_log_channel_created_idx")
  @@index([company_id, sent_at], map: "installment_reminder_log_company_id_sent_at_idx")
  @@index([enrollment_id, sent_at], map: "installment_reminder_log_enrollment_id_sent_at_idx")
  @@index([installment_id, sent_at], map: "installment_reminder_log_installment_id_sent_at_idx")
  @@index([channel, sent_at], map: "installment_reminder_log_channel_sent_at_idx")
  @@index([outbound_message_job_id], map: "installment_reminder_outbound_job_idx")
  @@map("installment_reminder_log")
}

