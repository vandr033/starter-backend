  previousPlan               ShopPlan?     @map("previous_plan")
  newPlan                    ShopPlan      @map("new_plan")
  previousBillingCycle       BillingCycle? @map("previous_billing_cycle")
  newBillingCycle            BillingCycle  @map("new_billing_cycle")
  previousPricePaid          Decimal?      @map("previous_price_paid") @db.Decimal(10, 2)
  newPricePaid               Decimal?      @map("new_price_paid") @db.Decimal(10, 2)
