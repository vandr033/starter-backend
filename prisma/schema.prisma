generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                                    Int                                @id @default(autoincrement())
  slug                                  String                             @unique @db.VarChar(64)
  name                                  String
  address                               String?                            @db.VarChar(255)
  phone_prefix                          String                             @default("591") @db.VarChar(8)
  phone                                 String                             @db.VarChar(32)
  email                                 String?
  google_maps_url                       String?                            @db.VarChar(512)
  timezone                              String                             @db.VarChar(64)
  currency                              String                             @default("Bs.") @db.VarChar(3)
  logo_url                              String?                            @db.VarChar(512)
  home_hero_image_url                   String?                            @db.VarChar(512)
  about_hero_image_url                  String?                            @db.VarChar(512)
  about_image_1_url                     String?                            @db.VarChar(512)
  about_image_2_url                     String?                            @db.VarChar(512)
  about_image_3_url                     String?                            @db.VarChar(512)
  is_active                             Boolean                            @default(true)
  created_at                            DateTime                           @default(now())
  updated_at                            DateTime                           @updatedAt
  deleted_at                            DateTime?
  company_type_id                       Int
  city                                  String?                            @db.VarChar(128)
  country_code                          String?                            @db.VarChar(2)
  state                                 String?                            @db.VarChar(128)
  latitude                              Float?
  longitude                             Float?
  about_us_hero_text                    String?                            @db.Text
  about_us_text                         String?                            @db.Text
  our_story_text                        String?                            @db.Text
  plan                                  ShopPlan                           @default(BUSINESS)
  billingCycle                          BillingCycle                       @default(MONTHLY) @map("billing_cycle")
  pricePaid                             Decimal?                           @map("price_paid") @db.Decimal(10, 2)
  availableUntil                        DateTime                           @default(dbgenerated("'2027-03-12 23:59:59.000'")) @map("available_until")
  isMarketplaceVisible                  Boolean                            @default(true) @map("is_marketplace_visible")
  bookings                              Booking[]
  booking_discounts                     BookingDiscount[]
  booking_services                      BookingService[]
  categories                            Category[]
  company_type                          CompanyType                        @relation(fields: [company_type_id], references: [id])
  capability_overrides                  CompanyCapabilityOverride[]
  company_settings                      CompanySettings?
  company_users                         CompanyUser[]
  product_history                       CompanyProductHistory[]
  product_access_requests               ProductAccessRequest[]
  product_subscriptions                 CompanyProductSubscription[]
  config_messages                       ConfigMessage[]
  customer_profiles                     CustomerProfile[]
  discount_codes                        DiscountCode[]
  hours                                 Hours[]
  reviews                               Review[]
  services                              Service[]
  staff_profiles                        StaffProfile[]
  subscription_history                  CompanySubscriptionHistory[]
  staff_availability                    StaffAvailability[]
  staff_time_off                        StaffTimeOff[]
  staff_services                        StaffService[]
  theme_config                          ThemeConfig?
  group_events                          GroupEvent[]
  group_classes                         GroupClass[]
  group_class_sessions                  GroupClassSession[]
  group_staff_assignments               GroupStaffAssignment[]
  group_event_bookings                  GroupEventBooking[]
  group_class_enrollments               GroupClassEnrollment[]
  group_session_attendances             GroupSessionAttendance[]
  group_tickets                         GroupTicket[]
  group_event_interests                 GroupEventInterest[]
  group_class_interests                 GroupClassInterest[]
  free_event_registrations              FreeEventRegistration[]
  paid_event_guest_checkout_sessions    PaidEventGuestCheckoutSession[]
  group_class_guest_enrollment_sessions GroupClassGuestEnrollmentSession[]
  service_required_resources            ServiceRequiredResource[]
  installment_reminder_logs             InstallmentReminderLog[]

  @@index([availableUntil], map: "company_available_until_idx")
  @@index([plan, billingCycle], map: "company_plan_billing_cycle_idx")
  @@index([isMarketplaceVisible, is_active, city], map: "company_marketplace_visible_active_city_idx")
  @@index([city, country_code, is_active])
  @@index([is_active, city, state], map: "company_active_city_state_idx")
  @@index([company_type_id], map: "company_company_type_id_fkey")
  @@map("company")
}

model ThemeConfig {
  id                     Int                  @id @default(autoincrement())
  company_id             Int                  @unique
  brand_color            String               @db.VarChar(16)
  page_background_color  String               @db.VarChar(16)
  page_background_preset PageBackgroundPreset @default(light)
  cards_elevated         Boolean              @default(true)
  corner_radius          CornerRadius         @default(md)
  font_pairing           String               @default("classic") @db.VarChar(30)
  hero_variant           String               @default("hero-cinematic") @db.VarChar(30)
  services_variant       String               @default("services-grid") @db.VarChar(30)
  team_variant           String               @default("team-cards") @db.VarChar(30)
  home_cta_buttons       Json?
  home_section_order     Json?
  footer_config          Json?
  announcement_banners   Json?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  company                Company              @relation(fields: [company_id], references: [id])

  @@map("theme_config")
}

model CompanySettings {
  id                               Int      @id @default(autoincrement())
  company_id                       Int      @unique
  booking_buffer_minutes           Int      @default(10)
  booking_time_granularity_minutes Int      @default(5)
  cancel_limit_minutes             Int      @default(120)
  reschedule_limit_minutes         Int      @default(120)
  allow_qr_payment                 Boolean  @default(true)
  qr_image_url                     String?  @db.VarChar(512)
  allow_cash_payment               Boolean  @default(true)
  send_email_notifications         Boolean  @default(true)
  send_whatsapp_notifications      Boolean  @default(false)
  auto_approve_staff_time_off      Boolean  @default(false)
  max_advance_booking_days         Int?
  min_advance_booking_minutes      Int?
  require_comprobante_for_qr       Boolean  @default(true)
  auto_confirm_bookings            Boolean  @default(true)
  social_links                     Json     @default("{}")
  custom_tos                       String?  @db.Text
  staff_label                      String   @default("Staff") @db.VarChar(50)
  created_at                       DateTime @default(now())
  updated_at                       DateTime @updatedAt
  company                          Company  @relation(fields: [company_id], references: [id])

  @@map("company_settings")
}

model User {
  id                                    String                             @id @default(cuid())
  email                                 String                             @unique
  first_name                            String?                            @db.VarChar(100)
  last_name                             String?                            @db.VarChar(100)
  is_super_admin                        Boolean                            @default(false)
  is_active                             Boolean                            @default(true)
  must_change_password                  Boolean                            @default(false)
  deleted_at                            DateTime?
  phone_prefix                          String?                            @db.VarChar(8)
  createdAt                             DateTime                           @default(now())
  emailVerified                         Boolean                            @default(false)
  image                                 String?                            @db.VarChar(512)
  name                                  String
  updatedAt                             DateTime                           @updatedAt
  phoneNumber                           String?                            @unique @db.VarChar(32)
  phoneNumberVerified                   Boolean?                           @default(false)
  gender                                String?                            @db.VarChar(30)
  age                                   Int?
  accounts                              Account[]
  created_bookings                      Booking[]                          @relation("BookingCreatedBy")
  updated_bookings                      Booking[]                          @relation("BookingUpdatedBy")
  company_users                         CompanyUser[]
  capability_override_changes           CompanyCapabilityOverride[]        @relation("CompanyCapabilityOverrideCreatedBy")
  customer_profiles                     CustomerProfile[]
  requested_time_off                    StaffTimeOff[]                     @relation("StaffTimeOffRequestedBy")
  reviewed_time_off                     StaffTimeOff[]                     @relation("StaffTimeOffReviewedBy")
  subscription_history_changes          CompanySubscriptionHistory[]       @relation("CompanySubscriptionHistoryChangedBy")
  product_history_actions               CompanyProductHistory[]            @relation("CompanyProductHistoryActor")
  product_access_requests               ProductAccessRequest[]             @relation("ProductAccessRequestRequestedBy")
  resolved_product_access_requests      ProductAccessRequest[]             @relation("ProductAccessRequestResolvedBy")
  user_reviews                          Review[]
  sessions                              Session[]
  staff_profiles                        StaffProfile[]
  created_group_events                  GroupEvent[]                       @relation("GroupEventCreatedBy")
  created_group_classes                 GroupClass[]                       @relation("GroupClassCreatedBy")
  group_event_bookings                  GroupEventBooking[]
  group_class_enrollments               GroupClassEnrollment[]
  group_session_attendances             GroupSessionAttendance[]
  group_event_interests                 GroupEventInterest[]
  group_class_interests                 GroupClassInterest[]
  free_event_registrations              FreeEventRegistration[]
  paid_event_guest_checkout_sessions    PaidEventGuestCheckoutSession[]
  group_class_guest_enrollment_sessions GroupClassGuestEnrollmentSession[]
  marked_paid_installments              EnrollmentInstallment[]            @relation("InstallmentMarkedPaidBy")
  sent_installment_reminders            InstallmentReminderLog[]           @relation("InstallmentReminderSentBy")

  @@map("user")
}

model CompanySubscriptionHistory {
  id                         Int           @id @default(autoincrement())
  companyId                  Int           @map("company_id")
  previousPlan               ShopPlan?     @map("previous_plan")
  newPlan                    ShopPlan      @map("new_plan")
  previousBillingCycle       BillingCycle? @map("previous_billing_cycle")
  newBillingCycle            BillingCycle  @map("new_billing_cycle")
  previousPricePaid          Decimal?      @map("previous_price_paid") @db.Decimal(10, 2)
  newPricePaid               Decimal?      @map("new_price_paid") @db.Decimal(10, 2)
  previousAvailableUntil     DateTime?     @map("previous_available_until")
  newAvailableUntil          DateTime      @map("new_available_until")
  previousMarketplaceVisible Boolean?      @map("previous_marketplace_visible")
  newMarketplaceVisible      Boolean       @map("new_marketplace_visible")
  changedByUserId            String?       @map("changed_by_user_id")
  changedAt                  DateTime      @default(now()) @map("changed_at")
  note                       String?       @db.VarChar(500)
  changedBy                  User?         @relation("CompanySubscriptionHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  company                    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId, changedAt], map: "company_subscription_history_company_changed_at_idx")
  @@index([changedByUserId], map: "company_subscription_history_changed_by_user_id_idx")
  @@index([newPlan, changedAt], map: "company_subscription_history_new_plan_changed_at_idx")
  @@map("company_subscription_history")
}

model ProductCatalog {
  id                   Int                          @id @default(autoincrement())
  code                 ProductCode                  @unique
  name                 String                       @db.VarChar(120)
  description          String?                      @db.Text
  category             String                       @db.VarChar(50)
  isCoreProduct        Boolean                      @default(false) @map("is_core_product")
  isAddon              Boolean                      @default(false) @map("is_addon")
  isActive             Boolean                      @default(true) @map("is_active")
  sortOrder            Int                          @default(0) @map("sort_order")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  companySubscriptions CompanyProductSubscription[]
  tiers                ProductTier[]

  @@index([category, isActive], map: "product_catalog_category_is_active_idx")
  @@index([sortOrder], map: "product_catalog_sort_order_idx")
  @@map("product_catalog")
}

model ProductTier {
  id                   Int                          @id @default(autoincrement())
  productId            Int                          @map("product_id")
  code                 ProductTierCode              @unique
  name                 String                       @db.VarChar(120)
  description          String?                      @db.Text
  tierLevel            Int                          @map("tier_level")
  isBase               Boolean                      @default(false) @map("is_base")
  isPro                Boolean                      @default(false) @map("is_pro")
  isActive             Boolean                      @default(true) @map("is_active")
  sortOrder            Int                          @default(0) @map("sort_order")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  capabilities         ProductTierCapability[]
  companySubscriptions CompanyProductSubscription[]
  product              ProductCatalog               @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([productId, tierLevel], map: "product_tier_product_id_tier_level_key")
  @@index([productId, isActive], map: "product_tier_product_id_is_active_idx")
  @@index([sortOrder], map: "product_tier_sort_order_idx")
  @@map("product_tier")
}

model ProductTierCapability {
  id            Int                   @id @default(autoincrement())
  productTierId Int                   @map("product_tier_id")
  capability    ProductCapabilityCode
  createdAt     DateTime              @default(now()) @map("created_at")
  productTier   ProductTier           @relation(fields: [productTierId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productTierId, capability], map: "product_tier_capability_product_tier_id_capability_key")
  @@index([capability], map: "product_tier_capability_capability_idx")
  @@map("product_tier_capability")
}

model CompanyProductSubscription {
  id             Int                              @id @default(autoincrement())
  companyId      Int                              @map("company_id")
  productId      Int                              @map("product_id")
  productTierId  Int                              @map("product_tier_id")
  status         CompanyProductSubscriptionStatus @default(ACTIVE)
  billingCycle   BillingCycle?                    @map("billing_cycle")
  pricePaid      Decimal?                         @map("price_paid") @db.Decimal(10, 2)
  currency       String?                          @db.VarChar(3)
  startsAt       DateTime                         @default(now()) @map("starts_at")
  availableUntil DateTime?                        @map("available_until")
  cancelledAt    DateTime?                        @map("cancelled_at")
  createdAt      DateTime                         @default(now()) @map("created_at")
  updatedAt      DateTime                         @updatedAt @map("updated_at")
  company        Company                          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product        ProductCatalog                   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productTier    ProductTier                      @relation(fields: [productTierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, productId], map: "company_product_subscription_company_id_product_id_key")
  @@index([companyId, status], map: "company_product_subscription_company_id_status_idx")
  @@index([productId, productTierId, status], map: "company_product_subscription_product_tier_status_idx")
  @@index([availableUntil], map: "company_product_subscription_available_until_idx")
  @@map("company_product_subscription")
}

model CompanyCapabilityOverride {
  id              Int                   @id @default(autoincrement())
  companyId       Int                   @map("company_id")
  capability      ProductCapabilityCode
  value           Boolean
  reason          String?               @db.VarChar(255)
  createdByUserId String?               @map("created_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  expiresAt       DateTime?             @map("expires_at")
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User?                 @relation("CompanyCapabilityOverrideCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId, capability], map: "company_capability_override_company_id_capability_idx")
  @@index([createdByUserId], map: "company_capability_override_created_by_user_id_idx")
  @@index([expiresAt], map: "company_capability_override_expires_at_idx")
  @@map("company_capability_override")
}

model CompanyProductHistory {
  id            Int      @id @default(autoincrement())
  companyId     Int      @map("company_id")
  action        String   @db.VarChar(64)
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  actorUserId   String?  @map("actor_user_id")
  note          String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  actorUser     User?    @relation("CompanyProductHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId, createdAt], map: "company_product_history_company_id_created_at_idx")
  @@index([actorUserId], map: "company_product_history_actor_user_id_idx")
  @@map("company_product_history")
}

model ProductAccessRequest {
  id                Int                        @id @default(autoincrement())
  companyId         Int                        @map("company_id")
  requestedByUserId String                     @map("requested_by_user_id")
  productCode       ProductCode               @map("product_code")
  tierCode          ProductTierCode           @map("tier_code")
  capability        ProductCapabilityCode
  status            ProductAccessRequestStatus @default(PENDING)
  message           String?                    @db.VarChar(500)
  source            ProductAccessRequestSource
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  resolvedAt        DateTime?                  @map("resolved_at")
  resolvedByUserId  String?                    @map("resolved_by_user_id")
  internalNote      String?                    @map("internal_note") @db.VarChar(500)
  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedByUser   User                       @relation("ProductAccessRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedByUser    User?                      @relation("ProductAccessRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId, status], map: "product_access_request_company_id_status_idx")
  @@index([productCode, tierCode, status], map: "product_access_request_product_tier_status_idx")
  @@index([requestedByUserId], map: "product_access_request_requested_by_user_id_idx")
  @@index([resolvedByUserId], map: "product_access_request_resolved_by_user_id_idx")
  @@index([source, createdAt], map: "product_access_request_source_created_at_idx")
  @@map("product_access_request")
}

model CompanyUser {
  id                 Int             @id @default(autoincrement())
  company_id         Int
  user_id            String
  role               CompanyUserRole
  is_primary_contact Boolean         @default(false)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  deleted_at         DateTime?
  company            Company         @relation(fields: [company_id], references: [id])
  user               User            @relation(fields: [user_id], references: [id])

  @@unique([company_id, user_id, role])
  @@index([user_id])
  @@index([company_id, role])
  @@map("company_user")
}

model StaffProfile {
  id                      Int                       @id @default(autoincrement())
  company_id              Int
  user_id                 String
  display_name            String
  bio                     String?                   @db.Text
  image_url               String?                   @db.VarChar(512)
  is_bookable             Boolean                   @default(true)
  status                  StaffProfileStatus        @default(ACTIVE)
  resource_type           ResourceType              @default(PERSON)
  invite_token            String?                   @unique @db.VarChar(255)
  start_date              DateTime?
  end_date                DateTime?
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @updatedAt
  deleted_at              DateTime?
  availability_slots      StaffAvailability[]
  bookings                Booking[]                 @relation("BookingPrimaryStaff")
  secondary_bookings      Booking[]                 @relation("BookingSecondaryStaff")
  preferred_customers     CustomerProfile[]
  reviews                 Review[]
  company                 Company                   @relation(fields: [company_id], references: [id])
  user                    User                      @relation(fields: [user_id], references: [id])
  time_off_requests       StaffTimeOff[]
  staff_services          StaffService[]
  group_staff_assignments GroupStaffAssignment[]
  required_for_services   ServiceRequiredResource[]

  @@unique([company_id, user_id])
  @@index([company_id, is_bookable])
  @@index([user_id], map: "staff_profile_user_id_fkey")
  @@map("staff_profile")
}

model CustomerProfile {
  id                        Int                      @id @default(autoincrement())
  company_id                Int
  user_id                   String
  notes                     String?                  @db.Text
  preferred_staff_id        Int?
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  deleted_at                DateTime?
  bookings                  Booking[]
  company                   Company                  @relation(fields: [company_id], references: [id])
  preferred_staff           StaffProfile?            @relation(fields: [preferred_staff_id], references: [id])
  user                      User                     @relation(fields: [user_id], references: [id])
  group_event_bookings      GroupEventBooking[]
  group_class_enrollments   GroupClassEnrollment[]
  group_session_attendances GroupSessionAttendance[]
  group_event_interests     GroupEventInterest[]
  group_class_interests     GroupClassInterest[]

  @@unique([company_id, user_id])
  @@index([preferred_staff_id])
  @@index([user_id], map: "customer_profile_user_id_fkey")
  @@map("customer_profile")
}

model Category {
  id                     Int       @id @default(autoincrement())
  company_id             Int
  global_service_type_id Int?
  name                   String
  slug                   String
  description            String?
  position               Int       @default(0)
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  deleted_at             DateTime?

  company             Company            @relation(fields: [company_id], references: [id])
  global_service_type GlobalServiceType? @relation(fields: [global_service_type_id], references: [id])
  services            Service[]

  @@unique([company_id, slug])
  @@index([global_service_type_id])
  @@map("category")
}

model Service {
  id                 Int                       @id @default(autoincrement())
  company_id         Int
  name               String
  description        String?                   @db.Text
  price_cents        Int
  duration_minutes   Int
  position           Int                       @default(0)
  is_active          Boolean                   @default(true)
  created_at         DateTime                  @default(now())
  updated_at         DateTime                  @updatedAt
  deleted_at         DateTime?
  global_type_id     Int?
  category_id        Int
  booking_services   BookingService[]
  service_reviews    Review[]
  category           Category                  @relation(fields: [category_id], references: [id])
  company            Company                   @relation(fields: [company_id], references: [id])
  global_type        GlobalServiceType?        @relation(fields: [global_type_id], references: [id])
  staff_services     StaffService[]
  required_resources ServiceRequiredResource[]

  @@index([company_id, is_active])
  @@index([company_id, global_type_id, is_active], map: "service_company_global_active_idx")
  @@index([category_id, is_active, position])
  @@index([global_type_id], map: "service_global_type_id_fkey")
  @@map("service")
}

model Hours {
  id          Int      @id @default(autoincrement())
  company_id  Int
  day_of_week Int
  open_time   String?  @db.VarChar(8)
  close_time  String?  @db.VarChar(8)
  is_closed   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  company     Company  @relation(fields: [company_id], references: [id])

  @@index([company_id], map: "hours_company_id_idx")
  @@map("hours")
}

model Booking {
  id                  Int               @id @default(autoincrement())
  company_id          Int
  staff_id            Int
  secondary_staff_id  Int?
  customer_id         Int?
  client_name         String?
  client_email        String?
  client_phone_prefix String?           @db.VarChar(8)
  client_phone_number String?           @db.VarChar(32)
  booking_type        BookingType       @default(CUSTOMER)
  booking_source      BookingSource     @default(SALON_SITE)
  start_at            DateTime
  end_at              DateTime
  status              BookingStatus     @default(CONFIRMED)
  payment_method      PaymentMethod     @default(NONE)
  payment_status      PaymentStatus     @default(UNPAID)
  qr_proof_image_url  String?           @db.VarChar(512)
  rejection_reason    String?           @db.VarChar(500)
  total_price_cents   Int               @default(0)
  notes               String?           @db.Text
  created_by_user_id  String?
  updated_by_user_id  String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  deleted_at          DateTime?
  company             Company           @relation(fields: [company_id], references: [id])
  created_by          User?             @relation("BookingCreatedBy", fields: [created_by_user_id], references: [id])
  customer            CustomerProfile?  @relation(fields: [customer_id], references: [id])
  staff               StaffProfile      @relation("BookingPrimaryStaff", fields: [staff_id], references: [id])
  secondary_staff     StaffProfile?     @relation("BookingSecondaryStaff", fields: [secondary_staff_id], references: [id])
  updated_by          User?             @relation("BookingUpdatedBy", fields: [updated_by_user_id], references: [id])
  booking_discounts   BookingDiscount[]
  booking_services    BookingService[]
  booking_review      Review?

  @@index([company_id, staff_id, start_at, status])
  @@index([company_id, customer_id, start_at])
  @@index([booking_source, created_at], map: "booking_source_created_at_idx")
  @@index([staff_id, start_at, end_at, status])
