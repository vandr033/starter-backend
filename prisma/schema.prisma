// ─── Group Event (one-time) ─────────────────────────────────────────────────

model GroupEvent {
  id                      Int             @id @default(autoincrement())
  company_id              Int
  title                   String          @db.VarChar(255)
  slug                    String          @db.VarChar(255)
  description             String?         @db.Text
  no_availability_message String?         @db.Text
  cover_image_url         String?         @db.VarChar(512)
  thumbnail_url           String?         @db.VarChar(512)
  status                  GroupItemStatus @default(DRAFT)
  is_free                 Boolean         @default(true)
  price_cents             Int             @default(0)
  max_capacity            Int
  capacity_visible        Boolean         @default(false)
  start_at                DateTime
  end_at                  DateTime
  location_text           String?         @db.VarChar(500)
  created_by_user_id      String?
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt
  deleted_at              DateTime?

  company                            Company                         @relation(fields: [company_id], references: [id])
  created_by                         User?                           @relation("GroupEventCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  staff_assignments                  GroupStaffAssignment[]
  bookings                           GroupEventBooking[]
  attendances                        GroupSessionAttendance[]
  interests                          GroupEventInterest[]
  free_registrations                 FreeEventRegistration[]
  paid_event_guest_checkout_sessions PaidEventGuestCheckoutSession[]
  whatsapp_groups                    WhatsappEventGroup[]

  @@unique([company_id, slug])
  @@index([company_id, status])
  @@index([company_id, start_at])
  @@index([created_by_user_id])
  @@map("group_event")
}

// ─── Group Class (recurring) ────────────────────────────────────────────────

model GroupClass {
  id                       Int              @id @default(autoincrement())
  company_id               Int
  title                    String           @db.VarChar(255)
  slug                     String           @db.VarChar(255)
  description              String?          @db.Text
  cover_image_url          String?          @db.VarChar(512)
  thumbnail_url            String?          @db.VarChar(512)
  status                   GroupItemStatus  @default(DRAFT)
  pricing_mode             ClassPricingMode @default(PER_SESSION)
  price_cents              Int              @default(0)
  monthly_price_cents      Int?
  billing_day              Int?
  max_capacity_per_session Int
  capacity_visible         Boolean          @default(false)
  session_duration_minutes Int
  recurrence_type          RecurrenceType   @default(WEEKLY)
  recurrence_config        Json             @default("{}")
  recurrence_start_date    DateTime         @db.Date
  recurrence_end_date      DateTime?        @db.Date
  start_time               String           @db.VarChar(8)
  location_text            String?          @db.VarChar(500)
  created_by_user_id       String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt
  deleted_at               DateTime?

  company                   Company                            @relation(fields: [company_id], references: [id])
  created_by                User?                              @relation("GroupClassCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  sessions                  GroupClassSession[]
  staff_assignments         GroupStaffAssignment[]
  enrollments               GroupClassEnrollment[]
  interests                 GroupClassInterest[]
  guest_enrollment_sessions GroupClassGuestEnrollmentSession[]

  @@unique([company_id, slug])
  @@index([company_id, status])
  @@index([created_by_user_id])
  @@map("group_class")
}

// ─── Group Class Session (one instance of a recurring class) ────────────────

model GroupClassSession {
  id                    Int             @id @default(autoincrement())
  company_id            Int
  group_class_id        Int
  start_at              DateTime
  end_at                DateTime
  status                GroupItemStatus @default(PUBLISHED)
  max_capacity_override Int?
  cancelled_at          DateTime?
  cancel_reason         String?         @db.VarChar(500)
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  company     Company                  @relation(fields: [company_id], references: [id])
  group_class GroupClass               @relation(fields: [group_class_id], references: [id], onDelete: Cascade)
  attendances GroupSessionAttendance[]
  tickets     GroupTicket[]

  @@unique([group_class_id, start_at])
  @@index([company_id, group_class_id, start_at])
  @@index([group_class_id, start_at])
  @@map("group_class_session")
}

// ─── Staff assignment (polymorphic: event OR class) ─────────────────────────

model GroupStaffAssignment {
  id               Int            @id @default(autoincrement())
  company_id       Int
  group_event_id   Int?
  group_class_id   Int?
  staff_profile_id Int?
  display_name     String?        @db.VarChar(255)
  display_phone    String?        @db.VarChar(64)
  role             GroupStaffRole @default(INSTRUCTOR)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  company       Company       @relation(fields: [company_id], references: [id])
  group_event   GroupEvent?   @relation(fields: [group_event_id], references: [id], onDelete: Cascade)
  group_class   GroupClass?   @relation(fields: [group_class_id], references: [id], onDelete: Cascade)
  staff_profile StaffProfile? @relation(fields: [staff_profile_id], references: [id], onDelete: SetNull)

  @@index([company_id, group_event_id])
  @@index([company_id, group_class_id])
  @@index([staff_profile_id])
  @@map("group_staff_assignment")
}

// ─── Event Booking (one customer → one event) ──────────────────────────────

model GroupEventBooking {
  id                   Int                @id @default(autoincrement())
  company_id           Int
  group_event_id       Int
  customer_profile_id  Int?
  user_id              String
  status               GroupBookingStatus @default(PENDING)
  booked_spots         Int                @default(1)
  payment_method       PaymentMethod      @default(NONE)
  payment_status       PaymentStatus      @default(UNPAID)
  qr_proof_image_url   String?            @db.VarChar(512)
  total_price_cents    Int                @default(0)
  extra_attendees_json Json?
  notes                String?            @db.Text
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  cancelled_at         DateTime?

  company          Company                  @relation(fields: [company_id], references: [id])
  group_event      GroupEvent               @relation(fields: [group_event_id], references: [id])
  customer_profile CustomerProfile?         @relation(fields: [customer_profile_id], references: [id])
  user             User                     @relation(fields: [user_id], references: [id])
  attendances      GroupSessionAttendance[]
  tickets          GroupTicket[]

  @@index([company_id, group_event_id, status])
  @@index([company_id, group_event_id, user_id, status])
  @@index([user_id, group_event_id])
  @@index([customer_profile_id])
  @@map("group_event_booking")
}

// ─── Class Enrollment (pass/subscription for a class) ───────────────────────

model GroupClassEnrollment {
  id                   Int                @id @default(autoincrement())
  company_id           Int
  group_class_id       Int
  customer_profile_id  Int?
  user_id              String
  pricing_mode         ClassPricingMode
  price_cents_snapshot Int
  status               GroupBookingStatus @default(PENDING)
  payment_method       PaymentMethod      @default(NONE)
  payment_status       PaymentStatus      @default(UNPAID)
  qr_proof_image_url   String?            @db.VarChar(512)
  valid_from           DateTime
  valid_until          DateTime
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  cancelled_at         DateTime?

  company                   Company                  @relation(fields: [company_id], references: [id])
  group_class               GroupClass               @relation(fields: [group_class_id], references: [id])
  customer_profile          CustomerProfile?         @relation(fields: [customer_profile_id], references: [id])
  user                      User                     @relation(fields: [user_id], references: [id])
  attendances               GroupSessionAttendance[]
  tickets                   GroupTicket[]
  installments              EnrollmentInstallment[]
  installment_reminder_logs InstallmentReminderLog[]

  @@index([company_id, group_class_id, status])
  @@index([company_id, group_class_id, user_id, status, valid_until], map: "gce_cmp_cls_usr_sts_vu_idx")
  @@index([company_id, group_class_id, status, valid_from, valid_until], map: "gce_cmp_cls_sts_vf_vu_idx")
  @@index([user_id, group_class_id])
  @@index([customer_profile_id])
  @@map("group_class_enrollment")
}

// ─── Enrollment Installment (monthly payment for FULL_COURSE) ───────────────

model EnrollmentInstallment {
  id                      Int           @id @default(autoincrement())
  enrollment_id           Int
  installment_number      Int
  due_date                DateTime      @db.Date
  amount_cents            Int
  payment_status          PaymentStatus @default(UNPAID)
  payment_method          PaymentMethod @default(NONE)
  qr_proof_image_url      String?       @db.VarChar(512)
  paid_at                 DateTime?
  marked_paid_by_admin_id String?
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt

  enrollment           GroupClassEnrollment     @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  marked_paid_by_admin User?                    @relation("InstallmentMarkedPaidBy", fields: [marked_paid_by_admin_id], references: [id], onDelete: SetNull)
  reminder_logs        InstallmentReminderLog[]

  @@unique([enrollment_id, installment_number])
  @@index([enrollment_id])
  @@index([payment_status, due_date])
  @@index([marked_paid_by_admin_id])
  @@map("enrollment_installment")
}

model InstallmentReminderLog {
  id               Int      @id @default(autoincrement())
  company_id       Int
  enrollment_id    Int
  installment_id   Int
  sent_by_admin_id String?
  channel          String   @db.VarChar(16)
  recipient_email  String?  @db.VarChar(191)
  recipient_phone  String?  @db.VarChar(32)
  message_subject  String?  @db.VarChar(255)
  message_body     String?  @db.Text
  sent_at          DateTime @default(now())

  company       Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  enrollment    GroupClassEnrollment  @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  installment   EnrollmentInstallment @relation(fields: [installment_id], references: [id], onDelete: Cascade)
  sent_by_admin User?                 @relation("InstallmentReminderSentBy", fields: [sent_by_admin_id], references: [id], onDelete: SetNull)

  @@index([company_id, sent_at])
  @@index([enrollment_id, sent_at])
  @@index([installment_id, sent_at])
  @@index([sent_by_admin_id])
  @@index([channel, sent_at])
  @@map("installment_reminder_log")
}

// ─── Session Attendance ─────────────────────────────────────────────────────

model GroupSessionAttendance {
  id                     Int            @id @default(autoincrement())
  company_id             Int
  group_class_session_id Int?
  group_event_id         Int?
  customer_profile_id    Int?
  user_id                String
  enrollment_id          Int?
  event_booking_id       Int?
  checked_in_at          DateTime?
  checked_in_method      CheckInMethod?
  created_at             DateTime       @default(now())

  company          Company               @relation(fields: [company_id], references: [id])
  class_session    GroupClassSession?    @relation(fields: [group_class_session_id], references: [id], onDelete: Cascade)
  group_event      GroupEvent?           @relation(fields: [group_event_id], references: [id], onDelete: Cascade)
  customer_profile CustomerProfile?      @relation(fields: [customer_profile_id], references: [id])
  user             User                  @relation(fields: [user_id], references: [id])
  enrollment       GroupClassEnrollment? @relation(fields: [enrollment_id], references: [id], onDelete: SetNull)
  event_booking    GroupEventBooking?    @relation(fields: [event_booking_id], references: [id], onDelete: SetNull)

  @@unique([group_class_session_id, user_id])
  @@unique([group_event_id, user_id])
  @@index([company_id])
  @@index([enrollment_id])
  @@index([event_booking_id])
  @@index([customer_profile_id])
  @@map("group_session_attendance")
}

// ─── QR Ticket ──────────────────────────────────────────────────────────────

model GroupTicket {
  id                        Int          @id @default(autoincrement())
  company_id                Int
  group_event_booking_id    Int?
  group_class_enrollment_id Int?
  group_class_session_id    Int?
  ticket_code               String       @unique @db.VarChar(64)
  seat_number               Int?
  holder_name               String?      @db.VarChar(255)
  holder_email              String?      @db.VarChar(191)
  holder_phone              String?      @db.VarChar(64)
  status                    TicketStatus @default(ACTIVE)
  valid_from                DateTime
  valid_until               DateTime
  issued_at                 DateTime     @default(now())
  delivery_count            Int          @default(0)
  resend_count              Int          @default(0)
  last_sent_at              DateTime?
  used_at                   DateTime?
  cancelled_at              DateTime?
  created_at                DateTime     @default(now())
  updated_at                DateTime     @updatedAt

  company          Company               @relation(fields: [company_id], references: [id])
  event_booking    GroupEventBooking?    @relation(fields: [group_event_booking_id], references: [id], onDelete: Cascade)
  class_enrollment GroupClassEnrollment? @relation(fields: [group_class_enrollment_id], references: [id], onDelete: Cascade)
  class_session    GroupClassSession?    @relation(fields: [group_class_session_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([group_event_booking_id])
  @@index([group_class_enrollment_id])
  @@index([group_class_session_id])
  @@index([status, valid_until])
  @@map("group_ticket")
}

// ─── Interest capture (sold-out free events) ────────────────────────────────

model GroupEventInterest {
  id                  Int      @id @default(autoincrement())
  company_id          Int
  group_event_id      Int
  user_id             String
  customer_profile_id Int?
  created_at          DateTime @default(now())

  company          Company          @relation(fields: [company_id], references: [id])
  group_event      GroupEvent       @relation(fields: [group_event_id], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [user_id], references: [id])
  customer_profile CustomerProfile? @relation(fields: [customer_profile_id], references: [id])

  @@unique([group_event_id, user_id])
  @@index([company_id, group_event_id])
  @@map("group_event_interest")
}

model GroupClassInterest {
  id                  Int      @id @default(autoincrement())
  company_id          Int
  group_class_id      Int
  user_id             String
  customer_profile_id Int?
  created_at          DateTime @default(now())

  company          Company          @relation(fields: [company_id], references: [id])
  group_class      GroupClass       @relation(fields: [group_class_id], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [user_id], references: [id])
  customer_profile CustomerProfile? @relation(fields: [customer_profile_id], references: [id])

  @@unique([group_class_id, user_id])
  @@index([company_id, group_class_id])
  @@map("group_class_interest")
}

model FreeEventRegistration {
  id                          Int                         @id @default(autoincrement())
  group_event_id              Int
  company_id                  Int
  user_id                     String?
  reservation_code            String?                     @unique @db.VarChar(6)
  first_name                  String                      @db.VarChar(100)
  last_name                   String                      @db.VarChar(100)
  gender                      Gender
  age                         Int
  email                       String                      @db.VarChar(254)
  phone_prefix                String                      @db.VarChar(8)
  phone_number                String                      @db.VarChar(32)
  tos_accepted                Boolean                     @default(false)
  source                      String                      @default("free_event_form") @db.VarChar(50)
  status                      FreeEventRegistrationStatus @default(CONFIRMED)
  create_account_requested    Boolean                     @default(false)
  account_created             Boolean                     @default(false)
  account_verification_status AccountVerificationStatus   @default(NOT_REQUESTED)
  checked_in_at               DateTime?
  checked_in_method           CheckInMethod?
  created_at                  DateTime                    @default(now())
  updated_at                  DateTime                    @updatedAt

  group_event GroupEvent @relation(fields: [group_event_id], references: [id], onDelete: Cascade)
  company     Company    @relation(fields: [company_id], references: [id])
  user        User?      @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@unique([group_event_id, email])
  @@index([group_event_id, status])
  @@index([group_event_id, reservation_code])
  @@index([company_id, group_event_id])
  @@index([user_id])
  @@map("free_event_registration")
}

model PaidEventGuestCheckoutSession {
  id                       String    @id @default(cuid())
  company_id               Int
  group_event_id           Int
  resolved_user_id         String?
  full_name                String    @db.VarChar(191)
  first_name               String?   @db.VarChar(100)
  last_name                String?   @db.VarChar(100)
  email                    String    @db.VarChar(254)
  phone_prefix             String    @db.VarChar(8)
  phone_number             String    @db.VarChar(32)
  account_outcome          String    @db.VarChar(64)
  otp_hash                 String    @db.VarChar(255)
  otp_attempts             Int       @default(0)
  otp_max_attempts         Int       @default(5)
  otp_expires_at           DateTime
  resend_available_at      DateTime
  email_delivery_succeeded Boolean   @default(false)
  phone_delivery_succeeded Boolean   @default(false)
