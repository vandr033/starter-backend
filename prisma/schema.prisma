// ─── Group Event (one-time) ─────────────────────────────────────────────────

model GroupEvent {
  id                             Int             @id @default(autoincrement())
  company_id                     Int
  title                          String          @db.VarChar(255)
  slug                           String          @db.VarChar(255)
  description                    String?         @db.Text
  no_availability_message        String?         @db.Text
  cover_image_url                String?         @db.VarChar(512)
  thumbnail_url                  String?         @db.VarChar(512)
  status                         GroupItemStatus @default(DRAFT)
  is_private                     Boolean         @default(false)
  is_free                        Boolean         @default(true)
  price_cents                    Int             @default(0)
  max_capacity                   Int
  capacity_visible               Boolean         @default(false)
  registration_question_text     String?         @db.VarChar(500)
  registration_question_required Boolean         @default(false)
  start_at                       DateTime
  end_at                         DateTime
  location_text                  String?         @db.VarChar(500)
  created_by_user_id             String?
  created_at                     DateTime        @default(now())
  updated_at                     DateTime        @updatedAt
  deleted_at                     DateTime?

  company                            Company                         @relation(fields: [company_id], references: [id])
  created_by                         User?                           @relation("GroupEventCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  staff_assignments                  GroupStaffAssignment[]
  bookings                           GroupEventBooking[]
  attendances                        GroupSessionAttendance[]
  interests                          GroupEventInterest[]
  free_registrations                 FreeEventRegistration[]
  paid_event_guest_checkout_sessions PaidEventGuestCheckoutSession[]
  whatsapp_groups                    WhatsappEventGroup[]

  @@unique([company_id, slug])
  @@index([company_id, status])
  @@index([company_id, status, is_private])
  @@index([company_id, start_at])
  @@index([created_by_user_id])
  @@map("group_event")
}

// ─── Group Class (recurring) ────────────────────────────────────────────────

model GroupClass {
  id                       Int              @id @default(autoincrement())
  company_id               Int
  title                    String           @db.VarChar(255)
  slug                     String           @db.VarChar(255)
  description              String?          @db.Text
  cover_image_url          String?          @db.VarChar(512)
  thumbnail_url            String?          @db.VarChar(512)
  status                   GroupItemStatus  @default(DRAFT)
  pricing_mode             ClassPricingMode @default(PER_SESSION)
  price_cents              Int              @default(0)
  monthly_price_cents      Int?
  billing_day              Int?
  max_capacity_per_session Int
  capacity_visible         Boolean          @default(false)
  session_duration_minutes Int
  recurrence_type          RecurrenceType   @default(WEEKLY)
  recurrence_config        Json             @default("{}")
  recurrence_start_date    DateTime         @db.Date
  recurrence_end_date      DateTime?        @db.Date
  start_time               String           @db.VarChar(8)
  location_text            String?          @db.VarChar(500)
  created_by_user_id       String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt
  deleted_at               DateTime?

  company                   Company                            @relation(fields: [company_id], references: [id])
  created_by                User?                              @relation("GroupClassCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  sessions                  GroupClassSession[]
  staff_assignments         GroupStaffAssignment[]
  enrollments               GroupClassEnrollment[]
  interests                 GroupClassInterest[]
  guest_enrollment_sessions GroupClassGuestEnrollmentSession[]

  @@unique([company_id, slug])
  @@index([company_id, status])
  @@index([created_by_user_id])
  @@map("group_class")
}

// ─── Group Class Session (one instance of a recurring class) ────────────────

model GroupClassSession {
  id                                 Int             @id @default(autoincrement())
  company_id                         Int
  group_class_id                     Int
  start_at                           DateTime
  end_at                             DateTime
  status                             GroupItemStatus @default(PUBLISHED)
  max_capacity_override              Int?
  public_attendance_enabled          Boolean         @default(false)
  attendance_public_token            String?         @unique @db.VarChar(191)
  attendance_public_token_created_at DateTime?
  attendance_public_token_rotated_at DateTime?
  attendance_access_code_enabled     Boolean         @default(false)
  attendance_access_code_hash        String?         @db.VarChar(255)
  attendance_access_code_updated_at  DateTime?
  cancelled_at                       DateTime?
  cancel_reason                      String?         @db.VarChar(500)
  created_at                         DateTime        @default(now())
  updated_at                         DateTime        @updatedAt

  company                    Company                               @relation(fields: [company_id], references: [id])
  group_class                GroupClass                            @relation(fields: [group_class_id], references: [id], onDelete: Cascade)
  attendances                GroupSessionAttendance[]
  tickets                    GroupTicket[]
  sponsored_enrollments      GroupClassEnrollment[]                @relation("SponsoredBySession")
  guest_enrollment_sessions  GroupClassGuestEnrollmentSession[]
  public_attendance_attempts GroupSessionPublicAttendanceAttempt[]

  @@unique([group_class_id, start_at])
  @@index([company_id, group_class_id, start_at])
  @@index([group_class_id, start_at])
  @@index([company_id, attendance_public_token], map: "gcs_company_token_idx")
  @@map("group_class_session")
}

// ─── Staff assignment (polymorphic: event OR class) ─────────────────────────

model GroupStaffAssignment {
  id               Int            @id @default(autoincrement())
  company_id       Int
  group_event_id   Int?
  group_class_id   Int?
  staff_profile_id Int?
  display_name     String?        @db.VarChar(255)
  display_phone    String?        @db.VarChar(64)
  role             GroupStaffRole @default(INSTRUCTOR)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  company       Company       @relation(fields: [company_id], references: [id])
  group_event   GroupEvent?   @relation(fields: [group_event_id], references: [id], onDelete: Cascade)
  group_class   GroupClass?   @relation(fields: [group_class_id], references: [id], onDelete: Cascade)
  staff_profile StaffProfile? @relation(fields: [staff_profile_id], references: [id], onDelete: SetNull)

  @@index([company_id, group_event_id])
  @@index([company_id, group_class_id])
  @@index([staff_profile_id])
  @@map("group_staff_assignment")
}

// ─── Event Booking (one customer → one event) ──────────────────────────────

model GroupEventBooking {
  id                           Int                @id @default(autoincrement())
  company_id                   Int
  group_event_id               Int
  customer_profile_id          Int?
  user_id                      String
  status                       GroupBookingStatus @default(PENDING)
  booked_spots                 Int                @default(1)
  payment_method               PaymentMethod      @default(NONE)
  payment_status               PaymentStatus      @default(UNPAID)
  qr_proof_image_url           String?            @db.VarChar(512)
  total_price_cents            Int                @default(0)
  extra_attendees_json         Json?
  registration_question_answer String?            @db.Text
  notes                        String?            @db.Text
  created_at                   DateTime           @default(now())
  updated_at                   DateTime           @updatedAt
  cancelled_at                 DateTime?

  company          Company                  @relation(fields: [company_id], references: [id])
