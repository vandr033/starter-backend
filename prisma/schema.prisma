generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   Int                          @id @default(autoincrement())
  slug                 String                       @unique @db.VarChar(64)
  name                 String
  address              String?                      @db.VarChar(255)
  phone_prefix         String                       @default("591") @db.VarChar(8)
  phone                String                       @db.VarChar(32)
  email                String?
  google_maps_url      String?                      @db.VarChar(512)
  timezone             String                       @db.VarChar(64)
  currency             String                       @default("Bs.") @db.VarChar(3)
  logo_url             String?                      @db.VarChar(512)
  home_hero_image_url  String?                      @db.VarChar(512)
  about_hero_image_url String?                      @db.VarChar(512)
  about_image_1_url    String?                      @db.VarChar(512)
  about_image_2_url    String?                      @db.VarChar(512)
  about_image_3_url    String?                      @db.VarChar(512)
  is_active            Boolean                      @default(true)
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @updatedAt
  deleted_at           DateTime?
  company_type_id      Int
  city                 String?                      @db.VarChar(128)
  country_code         String?                      @db.VarChar(2)
  state                String?                      @db.VarChar(128)
  latitude             Float?
  longitude            Float?
  about_us_hero_text   String?                      @db.Text
  about_us_text        String?                      @db.Text
  our_story_text       String?                      @db.Text
  plan                 ShopPlan                     @default(BUSINESS)
  billingCycle         BillingCycle                 @default(MONTHLY) @map("billing_cycle")
  pricePaid            Decimal?                     @map("price_paid") @db.Decimal(10, 2)
  availableUntil       DateTime                     @default(dbgenerated("'2027-03-12 23:59:59.000'")) @map("available_until")
  isMarketplaceVisible Boolean                      @default(true) @map("is_marketplace_visible")
  bookings             Booking[]
  booking_discounts    BookingDiscount[]
  booking_services     BookingService[]
  categories           Category[]
  company_type         CompanyType                  @relation(fields: [company_type_id], references: [id])
  company_settings     CompanySettings?
  company_users        CompanyUser[]
  config_messages      ConfigMessage[]
  customer_profiles    CustomerProfile[]
  discount_codes       DiscountCode[]
  hours                Hours[]
  reviews              Review[]
  services             Service[]
  staff_profiles       StaffProfile[]
  subscription_history CompanySubscriptionHistory[]
  staff_availability   StaffAvailability[]
  staff_time_off       StaffTimeOff[]
  staff_services       StaffService[]
  theme_config         ThemeConfig?

  @@index([availableUntil], map: "company_available_until_idx")
  @@index([plan, billingCycle], map: "company_plan_billing_cycle_idx")
  @@index([isMarketplaceVisible, is_active, city], map: "company_marketplace_visible_active_city_idx")
  @@index([city, country_code, is_active])
  @@index([is_active, city, state], map: "company_active_city_state_idx")
  @@index([company_type_id], map: "company_company_type_id_fkey")
  @@map("company")
}

model ThemeConfig {
  id                     Int                  @id @default(autoincrement())
  company_id             Int                  @unique
  brand_color            String               @db.VarChar(16)
  page_background_color  String               @db.VarChar(16)
  page_background_preset PageBackgroundPreset @default(light)
  cards_elevated         Boolean              @default(true)
  corner_radius          CornerRadius         @default(md)
  font_pairing           String               @default("classic") @db.VarChar(30)
  hero_variant           String               @default("hero-cinematic") @db.VarChar(30)
  services_variant       String               @default("services-grid") @db.VarChar(30)
  team_variant           String               @default("team-cards") @db.VarChar(30)
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  company                Company              @relation(fields: [company_id], references: [id])

  @@map("theme_config")
}

model CompanySettings {
  id                               Int      @id @default(autoincrement())
  company_id                       Int      @unique
  booking_buffer_minutes           Int      @default(10)
  booking_time_granularity_minutes Int      @default(5)
  cancel_limit_minutes             Int      @default(120)
  reschedule_limit_minutes         Int      @default(120)
  allow_qr_payment                 Boolean  @default(true)
  qr_image_url                     String?  @db.VarChar(512)
  allow_cash_payment               Boolean  @default(true)
  send_email_notifications         Boolean  @default(true)
  send_whatsapp_notifications      Boolean  @default(false)
  auto_approve_staff_time_off      Boolean  @default(false)
  max_advance_booking_days         Int?
  min_advance_booking_hours        Int?
  social_links                     Json     @default("{}")
  created_at                       DateTime @default(now())
  updated_at                       DateTime @updatedAt
  company                          Company  @relation(fields: [company_id], references: [id])

  @@map("company_settings")
}

model User {
  id                           String                       @id @default(cuid())
  email                        String                       @unique
  first_name                   String?                      @db.VarChar(100)
  last_name                    String?                      @db.VarChar(100)
  is_super_admin               Boolean                      @default(false)
  is_active                    Boolean                      @default(true)
  must_change_password         Boolean                      @default(false)
  deleted_at                   DateTime?
  phone_prefix                 String?                      @db.VarChar(8)
  createdAt                    DateTime                     @default(now())
  emailVerified                Boolean                      @default(false)
  image                        String?                      @db.VarChar(512)
  name                         String
  updatedAt                    DateTime                     @updatedAt
  phoneNumber                  String?                      @unique @db.VarChar(32)
  phoneNumberVerified          Boolean?                     @default(false)
  accounts                     Account[]
  created_bookings             Booking[]                    @relation("BookingCreatedBy")
  updated_bookings             Booking[]                    @relation("BookingUpdatedBy")
  company_users                CompanyUser[]
  customer_profiles            CustomerProfile[]
  requested_time_off           StaffTimeOff[]               @relation("StaffTimeOffRequestedBy")
  reviewed_time_off            StaffTimeOff[]               @relation("StaffTimeOffReviewedBy")
  subscription_history_changes CompanySubscriptionHistory[] @relation("CompanySubscriptionHistoryChangedBy")
  user_reviews                 Review[]
  sessions                     Session[]
  staff_profiles               StaffProfile[]

  @@map("user")
}

model CompanySubscriptionHistory {
  id                         Int           @id @default(autoincrement())
  companyId                  Int           @map("company_id")
  previousPlan               ShopPlan?     @map("previous_plan")
  newPlan                    ShopPlan      @map("new_plan")
  previousBillingCycle       BillingCycle? @map("previous_billing_cycle")
  newBillingCycle            BillingCycle  @map("new_billing_cycle")
  previousPricePaid          Decimal?      @map("previous_price_paid") @db.Decimal(10, 2)
  newPricePaid               Decimal?      @map("new_price_paid") @db.Decimal(10, 2)
  previousAvailableUntil     DateTime?     @map("previous_available_until")
  newAvailableUntil          DateTime      @map("new_available_until")
  previousMarketplaceVisible Boolean?      @map("previous_marketplace_visible")
  newMarketplaceVisible      Boolean       @map("new_marketplace_visible")
  changedByUserId            String?       @map("changed_by_user_id")
  changedAt                  DateTime      @default(now()) @map("changed_at")
  note                       String?       @db.VarChar(500)
  changedBy                  User?         @relation("CompanySubscriptionHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  company                    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId, changedAt], map: "company_subscription_history_company_changed_at_idx")
  @@index([changedByUserId], map: "company_subscription_history_changed_by_user_id_idx")
  @@index([newPlan, changedAt], map: "company_subscription_history_new_plan_changed_at_idx")
  @@map("company_subscription_history")
}

model CompanyUser {
  id                 Int             @id @default(autoincrement())
  company_id         Int
  user_id            String
  role               CompanyUserRole
  is_primary_contact Boolean         @default(false)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  deleted_at         DateTime?
  company            Company         @relation(fields: [company_id], references: [id])
  user               User            @relation(fields: [user_id], references: [id])

  @@unique([company_id, user_id, role])
  @@index([user_id])
  @@index([company_id, role])
  @@map("company_user")
}

model StaffProfile {
  id                  Int                 @id @default(autoincrement())
  company_id          Int
  user_id             String
  display_name        String
  bio                 String?             @db.Text
  image_url           String?             @db.VarChar(512)
  is_bookable         Boolean             @default(true)
  status              StaffProfileStatus  @default(ACTIVE)
  invite_token        String?             @unique @db.VarChar(255)
  start_date          DateTime?
  end_date            DateTime?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  deleted_at          DateTime?
  availability_slots  StaffAvailability[]
  bookings            Booking[]
  preferred_customers CustomerProfile[]
  reviews             Review[]
  company             Company             @relation(fields: [company_id], references: [id])
  user                User                @relation(fields: [user_id], references: [id])
  time_off_requests   StaffTimeOff[]
  staff_services      StaffService[]

  @@unique([company_id, user_id])
  @@index([company_id, is_bookable])
  @@index([user_id], map: "staff_profile_user_id_fkey")
  @@map("staff_profile")
}

model CustomerProfile {
  id                 Int           @id @default(autoincrement())
  company_id         Int
  user_id            String
  notes              String?       @db.Text
  preferred_staff_id Int?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  deleted_at         DateTime?
  bookings           Booking[]
  company            Company       @relation(fields: [company_id], references: [id])
  preferred_staff    StaffProfile? @relation(fields: [preferred_staff_id], references: [id])
  user               User          @relation(fields: [user_id], references: [id])

  @@unique([company_id, user_id])
  @@index([preferred_staff_id])
  @@index([user_id], map: "customer_profile_user_id_fkey")
  @@map("customer_profile")
}

model Category {
  id                     Int       @id @default(autoincrement())
  company_id             Int
  global_service_type_id Int?
  name                   String
  slug                   String
  description            String?
  position               Int       @default(0)
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  deleted_at             DateTime?

  company             Company            @relation(fields: [company_id], references: [id])
  global_service_type GlobalServiceType? @relation(fields: [global_service_type_id], references: [id])
  services            Service[]

  @@unique([company_id, slug])
  @@index([global_service_type_id])
  @@map("category")
}

model Service {
  id               Int                @id @default(autoincrement())
  company_id       Int
  name             String
  description      String?            @db.Text
  price_cents      Int
  duration_minutes Int
  position         Int                @default(0)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  deleted_at       DateTime?
  global_type_id   Int?
  category_id      Int
  booking_services BookingService[]
  service_reviews  Review[]
  category         Category           @relation(fields: [category_id], references: [id])
  company          Company            @relation(fields: [company_id], references: [id])
  global_type      GlobalServiceType? @relation(fields: [global_type_id], references: [id])
  staff_services   StaffService[]

  @@index([company_id, is_active])
  @@index([company_id, global_type_id, is_active], map: "service_company_global_active_idx")
  @@index([category_id, is_active, position])
  @@index([global_type_id], map: "service_global_type_id_fkey")
  @@map("service")
}

model Hours {
  id          Int      @id @default(autoincrement())
  company_id  Int
  day_of_week Int
  open_time   String?  @db.VarChar(8)
  close_time  String?  @db.VarChar(8)
  is_closed   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  company     Company  @relation(fields: [company_id], references: [id])

  @@index([company_id], map: "hours_company_id_idx")
  @@map("hours")
}

model Booking {
  id                  Int               @id @default(autoincrement())
  company_id          Int
  staff_id            Int
  customer_id         Int?
  client_name         String?
  client_email        String?
  client_phone_prefix String?           @db.VarChar(8)
  client_phone_number String?           @db.VarChar(32)
  booking_type        BookingType       @default(CUSTOMER)
  booking_source      BookingSource     @default(SALON_SITE)
  start_at            DateTime
  end_at              DateTime
  status              BookingStatus     @default(CONFIRMED)
  payment_method      PaymentMethod     @default(NONE)
  payment_status      PaymentStatus     @default(UNPAID)
  qr_proof_image_url  String?           @db.VarChar(512)
  rejection_reason    String?           @db.VarChar(500)
  total_price_cents   Int               @default(0)
  notes               String?           @db.Text
  created_by_user_id  String?
  updated_by_user_id  String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  deleted_at          DateTime?
  company             Company           @relation(fields: [company_id], references: [id])
  created_by          User?             @relation("BookingCreatedBy", fields: [created_by_user_id], references: [id])
  customer            CustomerProfile?  @relation(fields: [customer_id], references: [id])
  staff               StaffProfile      @relation(fields: [staff_id], references: [id])
  updated_by          User?             @relation("BookingUpdatedBy", fields: [updated_by_user_id], references: [id])
  booking_discounts   BookingDiscount[]
  booking_services    BookingService[]
  booking_review      Review?

  @@index([company_id, staff_id, start_at, status])
  @@index([company_id, customer_id, start_at])
  @@index([booking_source, created_at], map: "booking_source_created_at_idx")
  @@index([staff_id, start_at, end_at, status])
  @@index([created_by_user_id], map: "booking_created_by_user_id_fkey")
  @@index([customer_id], map: "booking_customer_id_fkey")
  @@index([updated_by_user_id], map: "booking_updated_by_user_id_fkey")
  @@map("booking")
}

model MarketplaceEvent {
  id         Int      @id @default(autoincrement())
  event_name String   @db.VarChar(64)
  payload    Json
  created_at DateTime @default(now())

  @@index([event_name, created_at], map: "marketplace_event_name_created_at_idx")
  @@map("marketplace_event")
}

model BookingService {
  id                        Int      @id @default(autoincrement())
  booking_id                Int
  company_id                Int
  service_id                Int
  service_name_snapshot     String
  price_cents_snapshot      Int
  duration_minutes_snapshot Int
  position                  Int      @default(0)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  booking                   Booking  @relation(fields: [booking_id], references: [id])
  company                   Company  @relation(fields: [company_id], references: [id])
  service                   Service  @relation(fields: [service_id], references: [id])

  @@index([booking_id])
  @@index([company_id, service_id])
  @@index([service_id], map: "booking_service_service_id_fkey")
  @@map("booking_service")
}

model DiscountCode {
  id                Int               @id @default(autoincrement())
  company_id        Int
  code              String            @db.VarChar(64)
  description       String?           @db.VarChar(255)
  type              DiscountType
  value             Decimal           @db.Decimal(10, 2)
  active_from       DateTime?
  active_until      DateTime?
  max_uses          Int?
  used_count        Int               @default(0)
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  deleted_at        DateTime?
  booking_discounts BookingDiscount[]
  company           Company           @relation(fields: [company_id], references: [id])

  @@unique([company_id, code])
  @@index([company_id, is_active, active_from, active_until])
  @@map("discount_code")
}

model BookingDiscount {
  id                    Int          @id @default(autoincrement())
  booking_id            Int
  discount_code_id      Int
  company_id            Int
  discount_amount_cents Int
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt
  booking               Booking      @relation(fields: [booking_id], references: [id])
  company               Company      @relation(fields: [company_id], references: [id])
  discount_code         DiscountCode @relation(fields: [discount_code_id], references: [id])

  @@unique([booking_id, discount_code_id])
  @@index([company_id])
  @@index([discount_code_id], map: "booking_discount_discount_code_id_fkey")
  @@map("booking_discount")
}

model ConfigMessage {
  id          Int      @id @default(autoincrement())
  company_id  Int
  name        String
  key         String
  value       String   @db.Text
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  company     Company  @relation(fields: [company_id], references: [id])

  @@unique([company_id, key])
  @@map("config_message")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_fkey")
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accountId             String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_fkey")
  @@map("account")
}

model VerificationCode {
  id           Int                 @id @default(autoincrement())
  channel      VerificationChannel
  purpose      VerificationPurpose
  identifier   String
  code_hash    String              @db.VarChar(255)
  attempts     Int                 @default(0)
  max_attempts Int                 @default(5)
  expires_at   DateTime
  consumed_at  DateTime?
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  @@index([identifier, channel, purpose, expires_at])
  @@map("verification_code")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

/// *
/// * types
model types {
  id         Int       @id @default(autoincrement())
  name       String
  image      String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("types")
}

model CompanyType {
  id               Int       @id @default(autoincrement())
  key              String    @unique @db.VarChar(64)
  name             String
  name_i18n        Json      @default("{}")
  description      String?   @db.VarChar(255)
  description_i18n Json      @default("{}")
  icon_name        String?   @db.VarChar(64)
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  companies        Company[]

  @@map("company_type")
}

model GlobalServiceType {
  id               Int        @id @default(autoincrement())
  key              String     @unique @db.VarChar(64)
  name             String
  name_i18n        Json       @default("{}")
  description      String?    @db.VarChar(255)
  description_i18n Json       @default("{}")
  services         Service[]
  categories       Category[]

  @@map("global_service_type")
}

model FrequentlyAskedQuestion {
  id         Int      @id @default(autoincrement())
  question   String   @db.VarChar(255)
  answer     String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("frequently_asked_question")
}

model Review {
  id                       Int           @id @default(autoincrement())
  company_id               Int
  user_id                  String
  service_id               Int?
  booking_id               Int?          @unique
  staff_id                 Int?
  rating                   Int
  comment                  String?       @db.Text
  rating_service_quality   Int?
  rating_staff_attention   Int?
  rating_punctuality       Int?
  rating_cleanliness       Int?
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt
  booking                  Booking?      @relation(fields: [booking_id], references: [id])
  company                  Company       @relation(fields: [company_id], references: [id])
  service                  Service?      @relation(fields: [service_id], references: [id])
  staff                    StaffProfile? @relation(fields: [staff_id], references: [id])
  user                     User          @relation(fields: [user_id], references: [id])

  @@index([company_id], map: "review_company_id_fkey")
  @@index([service_id], map: "review_service_id_fkey")
  @@index([user_id], map: "review_user_id_fkey")
  @@index([staff_id], map: "review_staff_id_fkey")
  @@index([company_id, created_at(sort: Desc)])
  @@map("review")
}

model StaffService {
  id                        Int          @id @default(autoincrement())
  company_id                Int
  staff_id                  Int
  service_id                Int
  price_cents_override      Int?
  duration_minutes_override Int?
  is_active                 Boolean      @default(true)
  created_at                DateTime     @default(now())
  updated_at                DateTime     @updatedAt
  company                   Company      @relation(fields: [company_id], references: [id])
  service                   Service      @relation(fields: [service_id], references: [id])
  staff                     StaffProfile @relation(fields: [staff_id], references: [id])

  @@unique([company_id, staff_id, service_id])
  @@index([company_id, service_id])
  @@index([staff_id, is_active])
  @@index([service_id], map: "staff_service_service_id_fkey")
  @@map("staff_service")
}

model StaffAvailability {
  id          Int          @id @default(autoincrement())
  company_id  Int
  staff_id    Int
  day_of_week Int
  start_time  String       @db.VarChar(8)
  end_time    String       @db.VarChar(8)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  company     Company      @relation(fields: [company_id], references: [id])
  staff       StaffProfile @relation(fields: [staff_id], references: [id])

  @@index([company_id, staff_id, day_of_week, is_active])
  @@index([staff_id], map: "staff_availability_staff_id_fkey")
  @@map("staff_availability")
}

model StaffTimeOff {
  id                   Int                @id @default(autoincrement())
  company_id           Int
  staff_id             Int
  requested_by_user_id String
  starts_at            DateTime
  ends_at              DateTime
  reason               String?            @db.VarChar(500)
  status               StaffTimeOffStatus @default(PENDING)
  review_note          String?            @db.VarChar(500)
  reviewed_by_user_id  String?
  reviewed_at          DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  deleted_at           DateTime?
  company              Company            @relation(fields: [company_id], references: [id])
  staff                StaffProfile       @relation(fields: [staff_id], references: [id])
  requested_by         User               @relation("StaffTimeOffRequestedBy", fields: [requested_by_user_id], references: [id])
  reviewed_by          User?              @relation("StaffTimeOffReviewedBy", fields: [reviewed_by_user_id], references: [id])

  @@index([company_id, staff_id, status, starts_at, ends_at])
  @@index([requested_by_user_id], map: "staff_time_off_requested_by_user_id_fkey")
  @@index([reviewed_by_user_id], map: "staff_time_off_reviewed_by_user_id_fkey")
  @@map("staff_time_off")
}

enum PageBackgroundPreset {
  light
  soft
  dark
  auto
}

enum CornerRadius {
  sm
  md
  lg
}

enum CompanyUserRole {
  OWNER
  ADMIN
  STAFF
  CUSTOMER
}

enum BookingType {
  CUSTOMER
  BLOCK
}

enum BookingSource {
  MARKETPLACE
  SALON_SITE
  ADMIN
  MANUAL
}

