PORT=3001
NODE_ENV="production"
JWT_SECRET=
STORAGE_PATH="./storage"
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="reservas"


# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://root@localhost:3306/reservas"

#Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=    # or your backend base URL

#email
MAIL_FROM=
MAIL_USER=
MAIL_PASS=

CUSTOMER_PREREG_SECRET=PREREGTOKENNN

#whatsapp
WASENDER_API_KEY=
WASENDER_PAT=

# OTP / verification
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limits
RATE_LIMIT_MAX_PER_MINUTE=600
AUTH_RATE_LIMIT_MAX_PER_MINUTE=60
BOOKING_AVAILABILITY_RATE_LIMIT_MAX_PER_MINUTE=1200
BOOKING_WRITE_RATE_LIMIT_MAX_PER_MINUTE=30
