PORT=3001
NODE_ENV="production"
JWT_SECRET=
STORAGE_PATH="./storage"
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="reservas"


# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://root@localhost:3306/reservas"

#Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=    # or your backend base URL

# Email provider. Delivery is disabled unless explicitly enabled.
MAIL_ENABLED=false
MAIL_TRANSPORT=disabled
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM=
MAIL_USER=
MAIL_PASS=
MAIL_CONNECTION_TIMEOUT_MS=15000
MAIL_GREETING_TIMEOUT_MS=15000
MAIL_SOCKET_TIMEOUT_MS=20000

CUSTOMER_PREREG_SECRET=PREREGTOKENNN

# WhatsApp (WAHA). External delivery is disabled unless explicitly enabled.
WAHA_ENABLED=false
WAHA_TRANSPORT=disabled
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_TIMEOUT_MS=15000
WAHA_MIN_INTERVAL_MS=5000
WAHA_DISCONNECT_ALERT_EMAIL=sebastian.andradeg@outlook.com
WAHA_MONITOR_INTERVAL_MS=30000
WHATSAPP_WORKER_ENABLED=true
WHATSAPP_WORKER_POLL_INTERVAL_MS=5000
WHATSAPP_JOB_LEASE_MS=120000
WHATSAPP_MAX_ATTEMPTS=8
WHATSAPP_WORKER_SHUTDOWN_TIMEOUT_MS=20000

# OTP / verification
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limits
RATE_LIMIT_MAX_PER_MINUTE=600
AUTH_RATE_LIMIT_MAX_PER_MINUTE=60
BOOKING_AVAILABILITY_RATE_LIMIT_MAX_PER_MINUTE=1200
BOOKING_WRITE_RATE_LIMIT_MAX_PER_MINUTE=30

# Public upload intents and signed cleanup tokens
UPLOAD_INTENT_SECRET=
UPLOAD_INTENT_TTL_SECONDS=600
UPLOAD_RATE_LIMIT_MAX_PER_MINUTE=30
STORAGE_DELETE_TOKEN_TTL_SECONDS=3600
